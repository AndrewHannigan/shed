[0.058, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[2;47r\u001b[3S\u001b[r\u001b[H\r\u001b[30B\u001b[38;2;78;186;101m⏺\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mWrote\u001b[12G\u001b[1m11\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1m../../.shed/workspaces/github.com/octocat/Hello-World/add-poem/POEM.md\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m  1 \u001b[22m# Hello, World\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;248;248;242m\u001b[2m  2 \r\u001b[5C\u001b[1B  3 \u001b[22mA single phrase, the place we all begin,\r\u001b[5C\u001b[1B\u001b[2m  4 \u001b[22mtwo words that prove the wiring works within.\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22mFrom punch cards down to prompts that think and plan,\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22meach program starts the way the first one ran.\r\u001b[5C\u001b[1B\u001b[2m  7 \r\u001b[5C\u001b[1B  8 \u001b[22mSo here it stands, the smallest repo grown,\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22ma greeting cast from octocat to clone.\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22mWhatever else the future versions do,\r\u001b[5C\u001b[1B\u001b[38;2;153;153;153m… +1 line \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m⏺\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[2B\u001b[38;2;215;119;87m*\u001b[3GPrestidigitating… \u001b[38;2;153;153;153m(32s · ↓\u001b[30G1.7k tokens)\u001b[39m"]
